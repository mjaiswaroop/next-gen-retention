# ─── Retention Core v3.0 Environment Configuration ──────────────────────────
ENVIRONMENT=development
SECRET_KEY=super_secret_dev_key_change_in_prod
DATABASE_URL=postgresql://retention:retention@localhost:5432/retention_core
ANALYTICS_DB_PATH=data/analytics.duckdb

# ─── Redis & Kafka ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── GenAI Win-Back Engine ──────────────────────────────────────────────────
# Required for Section 4 RAG generation
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Communication Channels (Section 4.2) ───────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@retentioncore.io
SENDGRID_FROM_NAME="Retention Core"
UNSUBSCRIBE_BASE_URL=https://retentioncore.io/unsubscribe

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000

# ─── CRM Integrations (Section 6) ───────────────────────────────────────────
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

HUBSPOT_ACCESS_TOKEN=

STRIPE_WEBHOOK_SECRET=

ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_TOKEN=dummy_token

# ─── ML Models ──────────────────────────────────────────────────────────────
EMOTION_MODEL_DEVICE=-1  # -1 for CPU, 0 for GPU
# ─── Observability (Section 7) ──────────────────────────────────────────────
# In Docker compose, Jaeger runs at this endpoint:
JAEGER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=retention-core-api
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=retentioncore

# ─── Data Privacy / Encryption (Section 3) ──────────────────────────────────
# Required Fernet keys for encrypting PII sidecars (must be valid 32-byte base64)
# Example: Generate via python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY_TENANT_1=
